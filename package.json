{
  "name": "logcarve-assets",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only browser asset build for LogCarve (Tailwind/daisyUI CSS, vendored JS, fonts, icons). No runtime CDN.",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/src/css/app.css -o ./app/web/static/app.css --minify",
    "build:vendor": "node ./scripts/build_vendor.mjs",
    "build:js": "mkdir -p ./app/web/static/js && cp ./assets/src/js/*.js ./app/web/static/js/",
    "build": "npm run build:vendor && npm run build:js && npm run build:css",
    "check:external": "node ./scripts/check_no_external.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "chart.js": "4.6.1",
    "daisyui": "5.7.50",
    "htmx.org": "2.0.11",
    "lucide-static": "1.66.0",
    "tailwindcss": "4.3.3"
  }
}
