# PRODUCT runtime contract (configuration loading implemented; the app reads these).
# Copy to a local .env for operation. Never commit actual .env.
APP_BASE_URL=https://logcarve.example.org
LOGCARVE_LOG_PATHS=/logs
DATABASE_PATH=/data/logcarve.sqlite3
DEFAULT_TIMEZONE=UTC
RETENTION_DAYS=30
EXTERNAL_API_ENABLED=true

# Required server secrets: generate separately, keep distinct, no insecure defaults.
SESSION_SECRET=
HMAC_KEY=

# Separate optional server key for encrypted original-IP storage (T1b).
# 32 random bytes as base64 or 64 hex chars. Empty fails capture/reads
# closed; never reuse SESSION_SECRET, HMAC_KEY or MODEL_API_KEY here.
ORIGINAL_IP_KEY=

# Optional mounted path of the genuine offline GeoIP country database
# (DB-IP Country Lite MMDB, T5a/PAR-09). Empty means unconfigured:
# imports store fixed "unavailable" markers and keep working. The
# database file itself is operator-mounted read-only and never lives
# in Git; see THIRD_PARTY_NOTICES.md for the CC BY 4.0 license and
# the required "IP Geolocation by DB-IP" attribution link.
GEOIP_DB_PATH=
# When true, a missing/unreadable configured database fails imports
# and reprocesses before any write (fixed code
# geoip_unavailable:database_required). Default false completes with
# "unavailable" markers instead.
GEOIP_REQUIRED=false

# Internal product assistant starts disabled. Account/provider policy is unverified.
# Backend Settings (Settings page, admin session + CSRF) may select the
# provider/model/data-policy and store per-provider keys encrypted in
# the database; these env values stay the backwards-compatible base.
AI_ENABLED=false
MODEL_PROVIDER=meta
MODEL_ID=muse-spark-1.3
MODEL_SERVICE_TIER=standard
MODEL_DATA_POLICY_VERIFIED=false
MODEL_ALLOW_REAL_DATA=false
MODEL_API_KEY=
# Dedicated server-only key for the DB-backed AI settings store
# (per-provider key encryption, ADR 0004). 32 random bytes as base64
# or 64 hex chars. Never reuse SESSION_SECRET, HMAC_KEY,
# ORIGINAL_IP_KEY or any MODEL/API key here; empty keeps all stored
# provider keys unreadable (fail-closed reads) while deterministic
# analytics keep working. Preserve this key separately: backups hold
# ciphertext only and cannot be decrypted without it.
AI_SETTINGS_KEY=
# Per-provider operator key fallbacks (used only when no stored DB key
# exists for that provider; Meta keeps MODEL_API_KEY above). Empty
# means not configured: dispatches fail closed.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional Anthropic workspace ID for non-workspace-scoped keys; empty
# means unset. Bounded plaintext setting, also settable in Settings.
ANTHROPIC_WORKSPACE_ID=
# Operator trusted assertion that imported source data is synthetic
# (never inferred from client questions or URLs). Required together
# with the per-provider "synthetic" Settings selection for
# synthetic-only demo mode; real data stays blocked otherwise.
AI_SYNTHETIC_SOURCE=false

# Proposed planning values, NOT proof of credit or a provider billing cap.
LLM_BUDGET_USD=150
LLM_WARN_AT_USD=120
LLM_STOP_AT_USD=140
# Set a deliberate daily limit before enabling chat; zero permits no paid calls.
LLM_DAILY_LIMIT_USD=0

# Optional later external Open-weight adapter; separate provider/key/budget required.
OPEN_MODEL_BASE_URL=
OPEN_MODEL_ID=meta-models/muse-spark-open-1026
OPEN_MODEL_API_KEY=

# Muse Code uses META_API_KEY in the developer's protected environment instead.
# Do not put development credentials into the product configuration or image.
