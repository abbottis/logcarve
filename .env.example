# Proposed PRODUCT runtime contract; no application consumes this scaffold yet.
# Copy only after configuration loading is implemented. Never commit actual .env.
APP_BASE_URL=https://logcarve.example.org
LOGCARVE_LOG_PATHS=/logs
DATABASE_PATH=/data/logcarve.sqlite3
DEFAULT_TIMEZONE=UTC
RETENTION_DAYS=30
EXTERNAL_API_ENABLED=true

# Required server secrets: generate separately, keep distinct, no insecure defaults.
SESSION_SECRET=
HMAC_KEY=

# Internal product assistant starts disabled. Account/provider policy is unverified.
AI_ENABLED=false
MODEL_PROVIDER=meta
MODEL_ID=muse-spark-1.3
MODEL_SERVICE_TIER=standard
MODEL_DATA_POLICY_VERIFIED=false
MODEL_ALLOW_REAL_DATA=false
MODEL_API_KEY=

# Proposed planning values, NOT proof of credit or a provider billing cap.
LLM_BUDGET_USD=150
LLM_WARN_AT_USD=120
LLM_STOP_AT_USD=140
# Set a deliberate daily limit before enabling chat; zero permits no paid calls.
LLM_DAILY_LIMIT_USD=0

# Optional later external Open-weight adapter; separate provider/key/budget required.
OPEN_MODEL_BASE_URL=
OPEN_MODEL_ID=meta-models/muse-spark-open-1026
OPEN_MODEL_API_KEY=

# Muse Code uses META_API_KEY in the developer's protected environment instead.
# Do not put development credentials into the product configuration or image.
